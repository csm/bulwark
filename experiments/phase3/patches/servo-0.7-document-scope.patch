+impl EvaluationInterrupt {
+    fn new(js_context: ThreadSafeJSContext) -> Option<Self> {
+        let state = Arc::<Mutex<EvaluationInterruptState>>::default();
+        let (watch, requests) = unbounded();
+        let watched = state.clone();
+        thread::Builder::new()
+            .name("EvaluationWatch".into())
+            .spawn(move || watch_evaluations(watched, requests, js_context))
+            .ok()?;
