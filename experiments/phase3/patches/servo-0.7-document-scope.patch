+impl Drop for ActiveEvaluation {
+    fn drop(&mut self) {
+        if let Some(state) = self.0.take() {
+            let mut state = state.lock().unwrap_or_else(|error| error.into_inner());
+            state.active = None;
+            state.interrupted = false;
+        }
+    }
