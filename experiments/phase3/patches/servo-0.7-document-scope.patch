+    fn finish(mut self) -> bool {
+        self.0.take().is_some_and(|state| {
+            let mut state = state.lock().unwrap_or_else(|error| error.into_inner());
+            state.active = None;
+            std::mem::take(&mut state.interrupted)
+        })
+    }
