;; The runtime tests and the pinned AOT compiler run this same source.
(ns bulwark.tests.shell-model
  (:require [bulwark.buffer :as buffer]
            [bulwark.commands :as commands :refer [defcommand]]
            [bulwark.keymap :as keymap]
            [bulwark.hooks :as hooks]
            [bulwark.mode :as mode]
            [bulwark.ui :as ui]
            [bulwark.window :as window]))

(defn check! [condition message]
  (when-not condition (throw (ex-info message {}))))

(defcommand sample "Returns the current implementation." [] :first)
(check! (= "Returns the current implementation."
           (:doc (commands/command-info 'bulwark.tests.shell-model/sample)))
        "Command documentation is missing")
(keymap/bind-key! "C-x b" 'bulwark.tests.shell-model/sample)
(check! (= 'bulwark.tests.shell-model/sample (get @keymap/bindings ["C-x" "b"]))
        "The keymap did not retain the command symbol")
(defn sample [] :second)
(check! (= :second ((deref (:var (commands/command-info 'bulwark.tests.shell-model/sample)))))
        "A command binding retained an obsolete function")
(check! (= ["C-x" "C-f"] (keymap/parse-keys "C-x C-f")) "Prefix parsing failed")
(check! (= ["M-x"] (keymap/parse-keys "M-x")) "Meta parsing failed")
(check! (= ["S-a"] (keymap/parse-keys "A")) "Shift parsing failed")
(keymap/unbind-key! "C-x b")
(check! (nil? (get @keymap/bindings ["C-x" "b"])) "Unbinding failed")
(let [published (atom [])]
  (keymap/set-route-publisher! (fn [sequences cancel] (swap! published conj sequences)))
  (keymap/bind-key! "C-x b" 'bulwark.tests.shell-model/sample)
  (check! (= [["C-x" "b"]] (last @published)) "The injected publisher did not receive reservations")
  (let [before @keymap/bindings]
    (check! (try (keymap/set-route-publisher! (fn [sequences cancel] (throw (ex-info "Rejected snapshot" {}))))
                 false (catch Exception error true)) "A rejected publisher was installed")
    (check! (= before @keymap/bindings) "Publisher failure changed bindings"))
  (keymap/unbind-key! "C-x b")
  (check! (= [] (last @published)) "Failed publisher replacement discarded the old publisher")
  (keymap/set-route-publisher! nil))
(let [before (count (get @hooks/registry :buffer/created))]
  (hooks/add-hook! :buffer/created :sample (fn [event] nil))
  (hooks/add-hook! :buffer/created :sample (fn [event] :replacement))
  (check! (= (inc before) (count (get @hooks/registry :buffer/created))) "Hook replacement duplicated an entry")
  (hooks/remove-hook! :buffer/created :sample)
  (check! (= before (count (get @hooks/registry :buffer/created))) "Hook removal failed"))
;; Buffer registry transitions take supplied identifiers and need no engine.
(defn fails? [f]
  (try (f) false (catch Exception error true)))
(let [web (buffer/make-buffer 10 :web {:view 3})
      text (buffer/make-buffer 11 :text {:name "*Messages*" :text "ready"})
      state (-> buffer/empty-registry (buffer/add web) (buffer/add text))]
  (check! (= [:web-mode :text-mode] [(:buffer/major-mode web) (:buffer/major-mode text)])
          "Buffer kinds lost their default major modes")
  (check! (and (nil? (:buffer/text web)) (= "ready" (:buffer/text text))) "Buffer text followed the wrong kind")
  (check! (and (nil? (:selected state)) (= [10 11] (:recent state)) (= 10 (get (:owners state) 3)))
          "Publication changed selection or lost ownership")
  (doseq [bad [(fn [] (buffer/make-buffer 0 :text {}))
               (fn [] (buffer/make-buffer 12 :tab {}))
               (fn [] (buffer/make-buffer 12 :web {}))
               (fn [] (buffer/make-buffer 12 :text {:view 4}))
               (fn [] (buffer/make-buffer 12 :text {:name ""}))
               (fn [] (buffer/add state web))
               (fn [] (buffer/add state (buffer/make-buffer 12 :web {:view 3})))
               (fn [] (buffer/add state (buffer/make-buffer 12 :repl {:name "*Messages*"})))
               (fn [] (buffer/select state 12))
               (fn [] (buffer/remove-buffer state 12))
               (fn [] (buffer/set-local state 12 :zoom 2))
               (fn [] (buffer/set-text state 10 "page"))]]
    (check! (fails? bad) "An invalid buffer transition was accepted"))
  (let [chosen (-> state (buffer/select 11) (buffer/select 10))
        titled (-> chosen
                   (buffer/page-event {:event/type :page/url-changed :webview 3 :url "about:a"})
                   (buffer/page-event {:event/type :page/title-changed :webview 3 :title "A"})
                   (buffer/page-event {:event/type :page/title-changed :webview 4 :title "Unowned"})
                   (buffer/page-event {:event/type :input/key :webview 3 :key "a"}))
        killed (buffer/remove-buffer titled 10)
        late (buffer/page-event killed {:event/type :page/title-changed :webview 3 :title "Late"})
        closed (buffer/page-event late {:event/type :page/closed :webview 3})]
    (check! (and (= 10 (:selected chosen)) (= [10 11] (:recent chosen))) "Selection did not update recency")
    (check! (= {:url "about:a" :title "A"} (get (:pages titled) 3)) "Page events missed their view")
    (check! (= text (get (:buffers titled) 11)) "A page event changed another buffer")
    (check! (and (nil? (:selected killed)) (= [11] (:recent killed)) (empty? (:owners killed)))
            "Removal retained a reference")
    (check! (= {4 {:title "Unowned"}} (:pages late)) "A late event revived a killed buffer's page")
    (check! (and (empty? (:buffers (buffer/remove-buffer late 11))) (= #{3} (:closing late)))
            "A late event recreated a buffer")
    (check! (fails? (fn [] (buffer/add late (buffer/make-buffer 12 :web {:view 3}))))
            "A closing view accepted a new owner")
    (check! (empty? (:closing closed)) "The close event did not release its view"))
  (let [moded (-> state
                  (buffer/set-local 11 :fill-column 72)
                  (buffer/set-major-mode 11 :help-mode)
                  (buffer/enable-minor-mode 11 :reader-mode)
                  (buffer/enable-minor-mode 11 :vi-mode)
                  (buffer/enable-minor-mode 11 :reader-mode)
                  (buffer/set-text 11 "updated"))
        record (get (:buffers moded) 11)]
    (check! (= {:fill-column 72} (:buffer/locals record)) "Buffer-local variable was lost")
    (check! (= {} (:buffer/locals (get (:buffers moded) 10))) "A local variable leaked between buffers")
    (check! (= :help-mode (:buffer/major-mode record)) "Major mode did not change")
    (check! (= [:vi-mode :reader-mode] (:buffer/minor-modes record)) "Minor modes are not most-recent-first")
    (check! (= [:vi-mode] (:buffer/minor-modes (get (:buffers (buffer/disable-minor-mode moded 11 :reader-mode)) 11)))
            "Minor mode was not disabled")
    (check! (= "updated" (:buffer/text record)) "Buffer text did not change")))
;; A portable runtime has no host: text buffers work, and web buffers report the missing engine.
(reset! buffer/registry buffer/empty-registry)
(buffer/set-host! nil)
(let [id (buffer/next-id!)]
  (swap! buffer/registry buffer/add (buffer/make-buffer id :text {:name "*scratch*"}))
  (buffer/set-local! id :answer 42)
  (check! (= 42 (buffer/local id :answer)) "Registry accessor missed a local variable")
  (check! (= :fallback (buffer/local id :missing :fallback)) "Local default was ignored")
  (check! (= id (:buffer/id (buffer/find-named "*scratch*"))) "Named lookup failed")
  (check! (= "*scratch*" (buffer/display-name id)) "Display name ignored the explicit name")
  (check! (> (buffer/next-id!) id) "Portable identifiers repeated")
  (check! (fails? (fn [] (buffer/host-operation :create))) "A portable runtime claimed an engine")
  (check! (fails? (fn [] (buffer/set-host! {:create 1}))) "An invalid host was installed"))
(reset! buffer/registry buffer/empty-registry)
;; Window trees and layout are pure data with supplied identifiers.
(defn error-kind [f]
  (try (f) nil (catch Exception error (:error (ex-data error)))))
(let [viewport {:x 0 :y 0 :width 1001 :height 600}
      one (window/initial 1 10)
      two (window/split one 1 2 :row 11)
      three (window/split two 2 3 :column)
      rectangle (fn [state id] (first (filter (fn [r] (= id (:window/id r))) (window/layout state viewport))))]
  (check! (= [{:window/id 1 :window/buffer 10 :x 0 :y 0 :width 1001 :height 600 :revision 1}]
             (window/layout one viewport)) "A single window did not fill the viewport")
  (check! (= [[1 10] [2 11] [3 11]] (mapv (fn [leaf] [(:window/id leaf) (:window/buffer leaf)]) (window/windows three)))
          "Splits lost their order or buffers")
  (check! (and (= 1 (:selected three)) (= 3 (:revision three))) "A split moved selection or kept its revision")
  (check! (= [[0 0 500 600] [500 0 501 300] [500 300 501 300]]
             (mapv (fn [r] [(:x r) (:y r) (:width r) (:height r)]) (window/layout three viewport)))
          "Layout rectangles do not tile the viewport")
  (check! (every? (fn [r] (= 3 (:revision r))) (window/layout three viewport)) "Rectangles lost the layout revision")
  (check! (= [20 30] (mapv (first (window/layout one {:x 20 :y 30 :width 240 :height 100})) [:x :y]))
          "Layout ignored the viewport origin")
  (let [wider (window/resize three 1 :row 250)
        taller (window/resize three 3 :column 100)
        clamped (window/resize three 1 :row 5000)]
    (check! (= [750 251] [(:width (rectangle wider 1)) (:width (rectangle wider 2))]) "Row resize failed")
    (check! (= [240 360] [(:height (rectangle taller 2)) (:height (rectangle taller 3))])
            "Growing a second child did not shrink the first")
    (check! (= 500 (:width (rectangle taller 1))) "A column resize changed a row split")
    (check! (= 900 (:width (rectangle clamped 1))) "Resize exceeded the maximum share")
    (check! (= :no-split (error-kind (fn [] (window/resize three 1 :column 10)))) "Resize found a missing split")
    (check! (= :no-split (error-kind (fn [] (window/resize one 1 :row 10)))) "A sole window was resized"))
  (let [selected (window/select three 3)
        without-three (window/delete selected 3)
        without-one (window/delete three 1)
        shown (window/set-buffer three 3 12)]
    (check! (= 2 (:selected without-three)) "Deleting the selected window lost the selection")
    (check! (= [1 2] (mapv :window/id (window/windows without-three))) "Delete removed the wrong window")
    (check! (= [500 0 501 600] (mapv (rectangle without-three 2) [:x :y :width :height]))
            "A sibling did not take the freed space")
    (check! (= 2 (:selected without-one)) "Deleting the first window selected a stale window")
    (check! (= :column (:split/direction (:root without-one))) "The surviving split was not promoted")
    (check! (= 3 (:selected (window/delete selected 1))) "Deleting another window moved the selection")
    (check! (= 12 (:window/buffer (window/window shown 3))) "Buffer assignment failed")
    (check! (= 11 (:window/buffer (window/window shown 2))) "Buffer assignment changed another window")
    (check! (> (:revision shown) (:revision three)) "A change kept an obsolete revision"))
  (check! (= :sole-window (error-kind (fn [] (window/delete one 1)))) "The only window was deleted")
  (doseq [bad [(fn [] (window/select three 9)) (fn [] (window/delete three 9))
               (fn [] (window/split three 9 4 :row)) (fn [] (window/set-buffer three 9 10))
               (fn [] (window/resize three 9 :row 10))]]
    (check! (= :stale-window (error-kind bad)) "A stale window id was accepted"))
  (doseq [bad [(fn [] (window/split three 1 2 :row)) (fn [] (window/split three 1 4 :diagonal))
               (fn [] (window/initial 0 10)) (fn [] (window/layout one {:x 0 :y 0 :width 0 :height 600}))
               (fn [] (window/layout one {:x 0 :y 0 :width 10.5 :height 600}))]]
    (check! (fails? bad) "An invalid window operation was accepted"))
  (check! (= :window-too-small (error-kind (fn [] (window/layout three {:x 0 :y 0 :width 150 :height 600}))))
          "A window below the minimum size was laid out")
  ;; Under the single-visible-webview fallback, text panes may sit beside one web pane.
  (let [web? (fn [buffer] (contains? #{10 11} buffer))]
    (check! (= :multiple-visible-webviews (error-kind (fn [] (window/check-web-limit three web?))))
            "Two visible webviews were accepted")
    (let [mixed (-> three (window/set-buffer 2 20) (window/set-buffer 3 21))]
      (check! (= mixed (window/check-web-limit mixed web?)) "A mixed layout was rejected")
      (check! (= [1] (mapv :window/id (window/web-windows mixed web?))) "Web windows were miscounted"))))
;; Deleting the other windows and cycling follow layout order.
(let [three (-> (window/initial 1 10) (window/split 1 2 :row 11) (window/split 2 3 :column))
      only (window/only three 3)]
  (check! (= [2 3 1] (mapv (fn [offset] (window/following three offset)) [1 2 3])) "Window order did not cycle")
  (check! (= 2 (window/following (window/select three 3) -1)) "Window order did not cycle backward")
  (check! (and (= [3] (mapv :window/id (window/windows only))) (= 3 (:selected only))
               (> (:revision only) (:revision three)))
          "Deleting the other windows kept one of them")
  (check! (= :stale-window (error-kind (fn [] (window/only three 9)))) "A stale window survived alone"))
;; The registry holds the layout. Selection, removal, and window operations keep it valid.
(let [state (-> buffer/empty-registry
                (buffer/add (buffer/make-buffer 10 :web {:view 3}))
                (buffer/add (buffer/make-buffer 11 :web {:view 4}))
                (buffer/add (buffer/make-buffer 12 :text {:name "notes" :text "hello"}))
                (buffer/add (buffer/make-buffer 13 :text {:name "log"})))
      shown (fn [state] (mapv (fn [leaf] [(:window/id leaf) (:window/buffer leaf)])
                              (window/windows (:layout state))))
      one (buffer/select state 10 1)
      split (buffer/change-layout one window/split 1 2 :row 12)
      beside (buffer/change-layout split window/select 2)]
  (check! (nil? (:layout (buffer/select state 10))) "A selection without a window id created a window")
  (check! (and (= [[1 10]] (shown one)) (= 1 (:selected (:layout one)))) "The first selection created no window")
  (check! (= (:layout one) (:layout (buffer/select one 10 9))) "A reselection changed the layout")
  (check! (and (= [[1 10] [2 12]] (shown split)) (= 10 (:selected split))) "A split moved the selection")
  (check! (and (= 12 (:selected beside)) (= 12 (first (:recent beside))))
          "Selecting a window did not select its buffer")
  ;; A page selected from a text window takes the window that already shows a page.
  (let [paged (buffer/select beside 11)]
    (check! (= [[1 11] [2 12]] (shown paged)) "A second page became visible")
    (check! (and (= 1 (:selected (:layout paged))) (= 11 (:selected paged))) "The page's window was not selected"))
  (check! (= [[1 10] [2 13]] (shown (buffer/select beside 13))) "A text buffer left the selected window")
  (check! (= [[1 13] [2 12]] (shown (buffer/select split 13))) "A text buffer did not replace the page")
  (check! (= :multiple-visible-webviews
             (error-kind (fn [] (buffer/change-layout split window/set-buffer 2 11))))
          "A window operation showed a second page")
  (check! (= :multiple-visible-webviews (error-kind (fn [] (buffer/change-layout one window/split 1 2 :row))))
          "One page was split into two windows")
  (check! (= :stale-buffer (error-kind (fn [] (buffer/change-layout split window/set-buffer 2 99))))
          "A window showed a dead buffer")
  (check! (= :no-window (error-kind (fn [] (buffer/change-layout state window/select 1))))
          "A window operation ran without a layout")
  ;; A killed buffer's windows take the most recent buffer that keeps one page visible.
  (let [killed (buffer/remove-buffer beside 12)]
    (check! (= [[1 10] [2 13]] (shown killed)) "A window showed a second page after a kill")
    (check! (and (= 13 (:selected killed)) (= 13 (first (:recent killed)))) "The heir was not selected"))
  (let [killed (buffer/remove-buffer split 10)]
    (check! (and (= [[1 11] [2 12]] (shown killed)) (= 11 (:selected killed)) (contains? (:closing killed) 3))
            "The most recent page did not replace a killed page"))
  (let [killed (buffer/remove-buffer split 12)]
    (check! (and (= [[1 10] [2 13]] (shown killed)) (= 10 (:selected killed)))
            "A background window's kill moved the selection"))
  ;; A window without a replacement is deleted. The last window leaves no layout.
  (let [pair (-> buffer/empty-registry
                 (buffer/add (buffer/make-buffer 10 :web {:view 3}))
                 (buffer/add (buffer/make-buffer 12 :text {}))
                 (buffer/select 10 1)
                 (buffer/change-layout window/split 1 2 :row 12)
                 (buffer/change-layout window/select 2))
        alone (buffer/remove-buffer pair 12)
        none (buffer/remove-buffer alone 10)]
    (check! (and (= [[1 10]] (shown alone)) (= 10 (:selected alone))) "A window without a replacement survived")
    (check! (and (nil? (:layout none)) (nil? (:selected none))) "The last kill left a window"))
  ;; UI descriptions are plain data computed from the layout, the panes, and the viewport.
  (let [titled (-> split
                   (buffer/page-event {:event/type :page/url-changed :webview 3 :url "about:a"})
                   (buffer/page-event {:event/type :page/title-changed :webview 3 :title "Example"}))
        viewport {:width 1000 :height 760 :scale 2.0}
        describe (fn [state viewport] (ui/describe (:layout state) (buffer/panes state) viewport))
        described (describe titled viewport)
        kinds (fn [description] (mapv :ui/kind (:elements description)))]
    (check! (= {:focus 1
                :elements [{:ui/kind :web :ui/id 1 :x 0 :y 0 :width 500 :height 710 :webview 3}
                           {:ui/kind :line :x 0 :y 710 :width 500 :height 22
                            :text " Example  about:a" :emphasis true}
                           {:ui/kind :text :ui/id 2 :x 500 :y 0 :width 500 :height 710 :text "hello"}
                           {:ui/kind :line :x 500 :y 710 :width 500 :height 22 :text " notes" :emphasis false}
                           {:ui/kind :echo :x 0 :y 732 :width 1000 :height 28}]}
               described)
            "The mixed description is wrong")
    (check! (= (ui/structure described) (ui/structure (describe split viewport)))
            "A title change changed the structure")
    (check! (not= (ui/structure described) (ui/structure (describe beside viewport)))
            "A focus change kept the structure")
    (check! (not= (ui/structure described) (ui/structure (describe titled {:width 900 :height 760 :scale 2.0})))
            "A resize kept the structure")
    (reset! buffer/modeline-format (fn [context] (str (:buffer/id (:buffer context)) (when (:selected context) "*"))))
    (check! (= ["10*" "12"] (mapv :text (filter (fn [element] (= :line (:ui/kind element)))
                                                (:elements (describe titled viewport)))))
            "The modeline policy was ignored")
    (reset! buffer/modeline-format nil)
    ;; A frame that is too small shows the selected window alone, and never a zero size.
    (let [narrow (describe beside {:width 150 :height 400 :scale 1.0})
          tiny (describe titled {:width 100 :height 20 :scale 1.0})]
      (check! (and (= [:text :line :echo] (kinds narrow)) (= 2 (:focus narrow))
                   (= [0 0 150 350] (mapv (first (:elements narrow)) [:x :y :width :height])))
              "A narrow frame did not show the selected window alone")
      (check! (and (= [:web :echo] (kinds tiny)) (= [100 1] (mapv (first (:elements tiny)) [:width :height])))
              "A tiny frame produced a modeline or a zero size"))
    (check! (= {:focus nil :elements [{:ui/kind :echo :x 0 :y 732 :width 1000 :height 28}]}
               (ui/describe nil {} viewport))
            "A frame without windows is not the echo line alone")
    (let [long (buffer/set-text split 12 (apply str (repeat 20000 "x")))]
      (check! (= ui/max-text-characters (count (:text (nth (:elements (describe long viewport)) 2))))
              "A text pane exceeded its limit"))
    ;; Without a host, the frame has the default size.
    (check! (= ui/default-viewport (ui/viewport)) "A portable runtime claimed a window")
    (check! (= (:layout split) (ui/check-fit! (:layout split))) "A fitting layout was rejected")
    (let [crowded (-> (:layout split) (window/split 1 3 :row 12) (window/split 1 4 :row 12)
                      (window/split 1 5 :row 12))]
      (check! (= :window-too-small (error-kind (fn [] (ui/check-fit! crowded)))) "A crowded layout fit the frame")
      (check! (= [:web :line :echo] (kinds (ui/describe crowded (buffer/panes split) viewport)))
              "A crowded layout did not fall back to its selected window"))))
;; A registry update must retry when another writer commits during its transition.
(let [state (atom {:left 0}) first-call (atom true) calls (atom 0)]
  (swap! state (fn [before]
                 (swap! calls inc)
                 (when (compare-and-set! first-call true false)
                   (reset! state {:left 0 :right 1}))
                 (assoc before :left 1)))
  (check! (and (= {:left 1 :right 1} @state) (= 2 @calls)) "A registry swap lost a concurrent update"))
;; Deep trees do not consume the interpreter's native call stack.
(let [deep (reduce (fn [state id] (window/split state 1 id :row 12))
                   (window/initial 1 12) (range 2 65))
      changed (window/set-buffer deep 1 13)
      resized (window/resize changed 1 :row 10)
      deleted (window/delete resized 1)]
  (check! (= 64 (count (window/windows deep))) "A deep tree lost windows")
  (check! (= 13 (:window/buffer (window/window changed 1))) "A deep buffer assignment failed")
  (check! (= 63 (count (window/windows deleted))) "A deep deletion failed")
  (check! (= 64 (:selected (window/select deep 64))) "A deep selection failed")
  (check! (= :window-too-small (error-kind (fn [] (window/layout deep {:x 0 :y 0 :width 1000 :height 760}))))
          "A deep layout ignored minimum sizes"))
;; Several Unicode text panes share the frame budget, including their modelines.
(check! (= ["😀é" "😀"] [(ui/clip "😀é" 3) (ui/clip "😀é" 1)])
        "Unicode clipping used byte indices")
(let [layout (reduce (fn [state pair] (window/split state (first pair) (second pair) :row 12))
                     (window/initial 1 12) [[1 2] [1 3] [2 4] [1 5] [3 6] [2 7] [4 8]])
      text (apply str (repeat 20000 "😀"))
      panes (reduce (fn [panes id] (assoc panes id {:kind :text :text text :modeline text})) {} (range 1 9))
      description (ui/describe layout panes {:width 32768 :height 760 :scale 1.0})
      characters (reduce + (map (fn [element] (count (or (:text element) ""))) (:elements description)))]
  (check! (= 17 (count (:elements description))) "The frame lost a fitting text pane")
  (check! (<= characters ui/max-description-characters) "The text panes exceeded the frame budget")
  (check! (every? (fn [element] (seq (:text element)))
                 (filter (fn [element] (= :text (:ui/kind element))) (:elements description)))
          "A text pane received no content budget"))
;; Keymap precedence: input context, minor modes (most recent first), major mode, global.
(defcommand in-global "A command of the global keymap." [] :global)
(defcommand in-major "A command of a major mode." [] :major)
(defcommand in-older "A command of the minor mode enabled first." [] :older)
(defcommand in-newer "A command of the minor mode enabled last." [] :newer)
(defcommand in-context "A command of an input context." [] :context)
(def model-published (atom []))
(def model-reject (atom false))
(def letters ["C-c a" "C-c b" "C-c c" "C-c d"])
(defn here [command] (symbol "bulwark.tests.shell-model" command))
(defn found [keys]
  (let [result (keymap/lookup keys)]
    (if (map? result) [(name (:command result)) (:keymap result)] result)))
(defn row [strokes] (mapv found strokes))
(keymap/set-route-publisher!
  (fn [sequences cancel]
    (when @model-reject (throw (ex-info "Rejected snapshot" {})))
    (swap! model-published conj (set sequences))))
(doseq [keys (conj letters "C-x x" "C-y" "C-z z")]
  (keymap/bind-key! keys (here "in-global")))
(mode/register! :major :model-major "A major mode of the model."
                {:keymap {"C-c b" (here "in-major") "C-c c" (here "in-major") "C-c d" (here "in-major")
                          "C-x" (here "in-major") "C-y y" (here "in-major") "C-z y" (here "in-major")}
                 :locals {:width 70 :tabs 8}})
(mode/register! :minor :model-older "The minor mode enabled first."
                {:keymap {"C-c c" (here "in-older") "C-c d" (here "in-older")} :locals {:width 80 :wrap true}})
(mode/register! :minor :model-newer "The minor mode enabled last."
                {:keymap {"C-c d" (here "in-newer")} :locals {:width 90}})
(keymap/bind-key! :model-context "C-c a" (here "in-context"))
;; A keymap that is not active changes neither the effective map nor the reservations.
(check! (= (set (keys @keymap/bindings)) (last @model-published) (set (keys @keymap/effective)))
        "An inactive keymap changed the reservations")
(check! (= [["in-global" :global] ["in-global" :global] ["in-global" :global] ["in-global" :global]]
           (row letters))
        "The global keymap alone is wrong")
(keymap/activate! [:model-major])
(check! (= [["in-global" :global] ["in-major" :model-major] ["in-major" :model-major] ["in-major" :model-major]]
           (row letters))
        "A major mode did not precede the global keymap")
;; A higher command hides a lower prefix and its sequences. A higher prefix hides a
;; lower command. Lower sequences under a shared prefix stay reachable.
(check! (= [["in-major" :model-major] nil :prefix ["in-major" :model-major]
            :prefix ["in-major" :model-major] ["in-global" :global]]
           (row ["C-x" "C-x x" "C-y" "C-y y" "C-z" "C-z y" "C-z z"]))
        "Prefix conflicts between keymaps were resolved wrongly")
(check! (and (= (set (keys @keymap/effective)) (last @model-published))
             (not (contains? (last @model-published) ["C-x" "x"]))
             (not (contains? (last @model-published) ["C-y"])))
        "The reservations differ from the effective keymap")
(keymap/activate! [:model-newer :model-older :model-major])
(check! (= [["in-global" :global] ["in-major" :model-major] ["in-older" :model-older] ["in-newer" :model-newer]]
           (row letters))
        "Minor modes did not precede the major mode in order")
(keymap/activate! [:model-older :model-newer :model-major])
(check! (= ["in-older" :model-older] (found "C-c d")) "Minor mode order did not decide a conflict")
(keymap/set-context! :model-context)
(check! (= [["in-context" :model-context] ["in-major" :model-major] ["in-older" :model-older] ["in-older" :model-older]]
           (row letters))
        "An input context did not precede the modes")
;; A context change publishes again and cancels the pending prefix.
(let [count-before (count @model-published)]
  (reset! keymap/pending {:webview 1 :keys ["C-c"]})
  (keymap/set-context! nil)
  (check! (and (= (inc count-before) (count @model-published)) (empty? (:keys @keymap/pending)))
          "A context change kept a pending prefix or its reservations")
  (check! (= ["in-global" :global] (found "C-c a")) "A cleared context kept its keymap"))
;; A failed publication retains the active context, every keymap, and the effective map.
(let [before [@keymap/bindings @keymap/keymaps @keymap/active @keymap/effective (count @model-published)]
      unchanged? (fn [] (= before [@keymap/bindings @keymap/keymaps @keymap/active @keymap/effective
                                   (count @model-published)]))]
  (reset! model-reject true)
  (doseq [change [(fn [] (keymap/activate! [:model-major]))
                  (fn [] (keymap/set-context! :model-context))
                  (fn [] (keymap/bind-key! :model-older "C-c e" (here "in-older")))
                  (fn [] (keymap/unbind-key! :model-older "C-c d"))
                  (fn [] (keymap/bind-key! "C-c e" (here "in-global")))
                  (fn [] (keymap/remove-keymap! :model-older))
                  (fn [] (mode/register! :minor :model-older "Redefined." {:keymap {} :locals {:width 1}}))]]
    (check! (and (fails? change) (unchanged?)) "A failed publication changed the keymaps"))
  (check! (= "The minor mode enabled first." (:mode/doc (mode/mode-info :model-older)))
          "A failed publication redefined a mode")
  (reset! model-reject false))
;; One keymap rejects its own prefix conflicts. A live change reaches the effective map.
(check! (fails? (fn [] (keymap/bind-key! :model-major "C-x x" (here "in-major"))))
        "A keymap accepted a sequence under its own command")
(check! (fails? (fn [] (keymap/set-keymap! :model-newer {"C-c" (here "in-newer") "C-c d" (here "in-newer")})))
        "A replacement keymap accepted a prefix conflict")
(check! (fails? (fn [] (keymap/bind-key! :model-major "C-c z" 'bulwark.tests.shell-model/missing)))
        "A keymap accepted an unknown command")
(keymap/unbind-key! :model-older "C-c d")
(check! (= ["in-newer" :model-newer] (found "C-c d")) "An unbound mode key still hid a lower keymap")
(mode/register! :minor :model-older "The minor mode enabled first." {:locals {:width 80 :wrap true}})
(check! (= ["in-older" :model-older] (found "C-c c")) "A redefinition without a keymap lost its bindings")
(mode/register! :minor :model-older "The minor mode enabled first."
                {:keymap {"C-c c" (here "in-newer")} :locals {:width 80 :wrap true}})
(check! (= ["in-newer" :model-older] (found "C-c c")) "A redefined mode kept its old keymap")
;; A binding names its command. A plain defn changes the next invocation.
(defn in-newer [] :redefined)
(check! (= :redefined ((deref (:var (commands/command-info (:command (keymap/lookup "C-c d")))))))
        "A mode binding retained an obsolete function")
;; The selected buffer's modes are the active keymaps. Unknown modes contribute nothing.
(reset! buffer/registry
        (-> buffer/empty-registry
            (buffer/add (buffer/make-buffer 30 :text {:major-mode :model-major :locals {:tabs 2}}))
            (buffer/add (buffer/make-buffer 31 :text {:major-mode :undefined-mode}))
            (buffer/select 30 1)))
(buffer/sync-keymaps! @buffer/registry)
(check! (= [:model-major] (:modes @keymap/active)) "The selected buffer's major mode is not active")
(buffer/enable-minor-mode! 30 :model-older)
(buffer/enable-minor-mode! 30 :model-newer)
(check! (= [:model-newer :model-older :model-major] (:modes @keymap/active))
        "The selected buffer's minor modes are not active in order")
(let [count-before (count @model-published)]
  (buffer/enable-minor-mode! 31 :model-older)
  (buffer/set-local! 30 :unrelated 1)
  (check! (= count-before (count @model-published)) "A background buffer changed the reservations"))
;; Buffer-local variables: the buffer, then minor modes in order, then the major mode.
(check! (= [2 90 true :fallback] [(buffer/local 30 :tabs) (buffer/local 30 :width)
                                  (buffer/local 30 :wrap) (buffer/local 30 :missing :fallback)])
        "Mode defaults for local variables have the wrong precedence")
(check! (= [80 nil] [(buffer/local 31 :width) (buffer/local 31 :tabs)]) "A mode default leaked between buffers")
(reset! model-reject true)
(check! (and (fails? (fn [] (buffer/set-major-mode! 30 :undefined-mode)))
             (fails? (fn [] (buffer/disable-minor-mode! 30 :model-newer)))
             (= [:model-newer :model-older] (:buffer/minor-modes (buffer/buffer 30)))
             (= :model-major (:buffer/major-mode (buffer/buffer 30))))
        "A failed publication changed the selected buffer's modes")
(reset! model-reject false)
(buffer/set-major-mode! 30 :undefined-mode)
(check! (= ["in-global" :global] (found "C-c b")) "An undefined mode supplied a keymap")
(swap! buffer/registry buffer/select 31)
(buffer/sync-keymaps! @buffer/registry)
(check! (= [:model-older :undefined-mode] (:modes @keymap/active)) "Selection did not change the active keymaps")
;; Definitions are documented data with a fixed kind. The mode macros define async
;; commands, which an AOT binary can only interpret, so clj/tests/modes.cljrs covers them.
(mode/register! :major :model-help "A major mode with defaults." {:locals {:read-only true}})
(mode/register! :minor :model-zen "A minor mode without keys." {})
(check! (= [:major "A major mode with defaults." {:read-only true} nil]
           (mapv (mode/mode-info :model-help) [:mode/kind :mode/doc :mode/locals :mode/on-enable]))
        "A mode lost its definition")
(check! (= [:unknown-mode :wrong-mode-kind :wrong-mode-kind]
           [(error-kind (fn [] (mode/mode-info :missing-mode)))
            (error-kind (fn [] (mode/mode-of-kind! :model-zen :major)))
            (error-kind (fn [] (mode/register! :major :model-zen "Another kind." {})))])
        "Mode lookups accepted a wrong name or kind")
(doseq [bad [(fn [] (mode/register! :minor :model-bad "" {}))
             (fn [] (mode/register! :minor 'model-bad "Symbol name." {}))
             (fn [] (mode/register! :other :model-bad "Unknown kind." {}))
             (fn [] (mode/register! :minor :model-bad "Bad function." {:on-enable 1}))
             (fn [] (mode/register! :minor :model-bad "Bad keymap." {:keymap {"C-" 'in-newer}}))]]
  (check! (fails? bad) "An invalid mode definition was accepted"))
(check! (nil? (get @mode/registry :model-bad)) "A rejected definition was registered")
(reset! buffer/registry buffer/empty-registry)
(keymap/activate! [])
(doseq [keys (conj letters "C-x x" "C-y" "C-z z")] (keymap/unbind-key! keys))
(check! (and (empty? @keymap/effective) (= #{} (last @model-published))) "The model left reservations behind")
(keymap/set-route-publisher! nil)
(println "Shell model assertions passed")
:shell-model-passed
