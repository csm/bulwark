(ns bulwark.shell
  (:require [bulwark.native :as native]
            [bulwark.browser :as browser]
            [bulwark.buffer :as buffer]
            [bulwark.hooks :as hooks]
            [clojure.core.async :refer [timeout]]))

(defn value!
  "Returns a successful native value, or raises an error containing the reply."
  [reply]
  (when-not (:ok reply) (throw (ex-info "Native browser operation failed" reply)))
  (:value reply))

(defn ^:async dispatch!
  "Displays the selected buffer's titles and native key events in the echo area."
  [event]
  (case (:event/type event)
    ;; A background buffer's title must not replace the visible page's title.
    :page/title-changed (when (or (nil? (:buffer event)) (= (:buffer event) (buffer/selected-id)))
                          (await (native/set-echo! (:title event))))
    :buffer/selected (await (native/set-echo! (buffer/display-name (:buffer event))))
    :page/crashed (await (native/set-echo! (str "Page crashed: " (:message event))))
    ;; A command that fails after it suspended has no waiting dispatcher.
    :command/failed (await (native/set-echo! (str "Command failed: " (ex-message (:error event)))))
    :input/key (when (and (:pressed event) (= :unbound (:keymap/status event)))
                 (await (native/set-echo! (str "Key: " (:key event)))))
    nil))

(defn ^:async run!
  "Opens the initial page and keeps the runtime alive until native shutdown."
  [url]
  (browser/install!)
  (doseq [event-type [:page/title-changed :page/crashed :command/failed :input/key :buffer/selected]]
    (hooks/add-hook! event-type :bulwark.shell/echo #'dispatch!))
  (value! (await (native/set-echo! "Bulwark")))
  (await (browser/open! url))
  (loop [] (await (timeout 60000)) (recur)))
