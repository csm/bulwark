(ns bulwark.browser
  (:require [bulwark.native :as native]
            [bulwark.buffer :as buffer]
            [bulwark.commands :refer [defcommand]]
            [bulwark.hooks :as hooks]
            [bulwark.keymap :as keymap]
            [clojure.string :as string]))

(def history (atom []))
(def history-limit 256)
(def new-buffer-url (atom "about:blank"))

(defn value!
  "Returns a successful native value, or raises an error containing the reply."
  [reply]
  (when-not (:ok reply) (throw (ex-info "Native browser operation failed" reply)))
  (:value reply))

(defn active-view
  "Returns the selected web buffer's view handle, or nil."
  []
  (buffer/selected-view))

(defn current-view!
  "Returns the visible view handle, or reports that no page is open."
  []
  (or (active-view) (throw (ex-info "No active browser view" {}))))

(defn ^:async set-echo!
  "Displays text in the native echo area."
  [text]
  (value! (await (native/set-echo! text))))

(defn ^:async navigate!
  "Navigates the visible page."
  [url]
  (value! (await (native/navigate (current-view!) url))))

(defn track-page!
  "Retains the most recent 256 titled visits in memory. The buffer registry supplies each view's URL."
  [event]
  (when-let [url (:url (buffer/view-page (:webview event)))]
    (when (seq (:title event))
      (let [visit {:url url :title (:title event) :at (System/currentTimeMillis)}
            previous (last @history)]
        (when-not (= (select-keys previous [:url :title]) (select-keys visit [:url :title]))
          (swap! history (fn [visits] (vec (take-last history-limit (conj visits visit))))))))))

(defcommand ^:async reload
  "Reloads the visible page."
  []
  (value! (await (native/reload (current-view!)))))

(defcommand ^:async back
  "Moves backward in the visible page's navigation history."
  []
  (value! (await (native/back (current-view!)))))

(defcommand ^:async forward
  "Moves forward in the visible page's navigation history."
  []
  (value! (await (native/forward (current-view!)))))

(defcommand ^:async history-list
  "Shows recent page titles in the echo area, newest first."
  []
  (await (set-echo! (if (seq @history)
                     (string/join " | " (map :title (reverse (take-last 8 @history))))
                     "No titled pages yet"))))

(defn ^:async visit-history!
  "Navigates to a retained visit by zero-based index, oldest first."
  [index]
  (when-not (and (integer? index) (<= 0 index) (< index (count @history)))
    (throw (ex-info "History index is out of range" {:index index})))
  (await (navigate! (:url (nth @history index)))))

(defn ^:async open!
  "Opens a URL in a new web buffer and returns the buffer id. Options follow bulwark.buffer/create!."
  ([url] (await (open! url {})))
  ([url options] (await (buffer/create! (assoc options :kind :web :url url)))))

(defn ^:async replace-last-buffer!
  "Default policy after the last web buffer dies: open the new-buffer URL, unless the engine is stopping."
  [killed]
  (try
    (await (open! @new-buffer-url))
    (catch Exception error
      (when-not (contains? #{:shutting-down :engine-disconnected} (:error (ex-data error)))
        (throw error)))))

(defn ^:async cycle-buffer!
  "Selects the buffer a number of places after the selected one in creation order."
  [offset]
  (let [ids (mapv :buffer/id (buffer/buffers))
        selected (buffer/selected-id)
        position (first (filter (fn [index] (= selected (nth ids index))) (range (count ids))))]
    (when (empty? ids) (throw (ex-info "No buffers" {})))
    (await (buffer/select! (nth ids (mod (+ (or position 0) offset) (count ids)))))))

(defcommand ^:async new-buffer
  "Opens the new-buffer URL in a new selected buffer."
  []
  (await (open! @new-buffer-url)))

(defcommand ^:async kill-buffer
  "Kills the selected buffer and closes its page."
  []
  (await (buffer/kill! (or (buffer/selected-id) (throw (ex-info "No selected buffer" {}))))))

(defcommand ^:async next-buffer
  "Selects the next buffer in creation order."
  []
  (await (cycle-buffer! 1)))

(defcommand ^:async previous-buffer
  "Selects the previous buffer in creation order."
  []
  (await (cycle-buffer! -1)))

(defn install!
  "Installs browser hooks, the last-buffer policy, and default keys. Repeated installation replaces them."
  []
  (hooks/add-hook! :page/title-changed :bulwark.browser/track-page #'track-page!)
  (reset! buffer/last-web-buffer-policy #'replace-last-buffer!)
  (keymap/bind-key! "C-c n" 'bulwark.browser/new-buffer)
  (keymap/bind-key! "C-x k" 'bulwark.browser/kill-buffer)
  (keymap/bind-key! "C-x ArrowRight" 'bulwark.browser/next-buffer)
  (keymap/bind-key! "C-x ArrowLeft" 'bulwark.browser/previous-buffer)
  (keymap/bind-key! "C-c r" 'bulwark.browser/reload)
  (keymap/bind-key! "C-c b" 'bulwark.browser/back)
  (keymap/bind-key! "C-c f" 'bulwark.browser/forward)
  (keymap/bind-key! "C-x h" 'bulwark.browser/history-list))
