(ns bulwark.buffer
  (:require [bulwark.hooks :as hooks]
            [bulwark.keymap :as keymap]
            [bulwark.ui :as ui]
            [bulwark.window :as window]))

;; Registry state is one immutable map:
;;   :buffers  id -> buffer record
;;   :recent   buffer ids, most recently selected first, then creation order
;;   :selected the selected buffer id, or nil
;;   :owners   webview handle -> owning buffer id
;;   :pages    webview handle -> page state from engine events
;;   :closing  handles of killed web buffers whose close event is outstanding
;;   :layout   the bulwark.window layout state, or nil while no buffer is selected
;; With a layout, :selected is the buffer of the layout's selected window, every window
;; shows a live buffer, and at most one window shows a web buffer.
;; The transitions below are pure. They accept supplied identifiers and need no engine.

(def kinds #{:web :text :repl})
(def default-major-modes {:web :web-mode :text :text-mode :repl :repl-mode})
(def empty-registry {:buffers {} :recent [] :selected nil :owners {} :pages {} :closing #{} :layout nil})
(def registry (atom empty-registry))
(def host (atom nil))
(def last-web-buffer-policy (atom nil))
(def portable-ids (atom 0))
(def modeline-format (atom nil))
(def refresh-failure (atom nil))
(def keymap-failure (atom nil))
;; Mode keyword -> default values for buffer-local variables. bulwark.mode maintains it.
(def mode-locals (atom {}))

(defn id?
  "Returns true for a positive integer identifier."
  [value]
  (and (integer? value) (pos? value)))

(defn stale!
  "Raises the error for a buffer id that names no live buffer."
  [id]
  (throw (ex-info "No live buffer has this id" {:error :stale-buffer :buffer id})))

(defn make-buffer
  "Builds a buffer record from a supplied id, a kind, and an options map.
  Options: :name, :view (required for :web, forbidden otherwise), :major-mode, :locals, :text."
  [id kind options]
  (let [view (:view options)
        name (:name options)
        mode (get options :major-mode (get default-major-modes kind))
        locals (get options :locals {})
        text (when-not (= kind :web) (get options :text ""))]
    (when-not (id? id)
      (throw (ex-info "Buffer id must be a positive integer" {:buffer id})))
    (when-not (contains? kinds kind)
      (throw (ex-info "Buffer kind must be :web, :text, or :repl" {:kind kind})))
    (when-not (if (= kind :web) (id? view) (nil? view))
      (throw (ex-info "Exactly the web buffers own a webview handle" {:kind kind :view view})))
    (when-not (or (nil? name) (and (string? name) (seq name)))
      (throw (ex-info "Buffer name must be a nonempty string or nil" {:name name})))
    (when-not (and (keyword? mode) (map? locals) (or (nil? text) (string? text)))
      (throw (ex-info "Buffer mode, locals, or text has the wrong type" {:buffer id})))
    {:buffer/id id :buffer/kind kind :buffer/name name :buffer/view view
     :buffer/major-mode mode :buffer/minor-modes [] :buffer/locals locals :buffer/text text}))

(defn add
  "Publishes a buffer record. Rejects a reused id, an owned or closing view, and a duplicate name."
  [state buffer]
  (let [id (:buffer/id buffer) view (:buffer/view buffer) name (:buffer/name buffer)]
    (when (contains? (:buffers state) id)
      (throw (ex-info "Buffer id is already registered" {:buffer id})))
    (when (and view (or (contains? (:owners state) view) (contains? (:closing state) view)))
      (throw (ex-info "Webview handle already belongs to a buffer" {:view view})))
    (when (and name (some (fn [other] (= name (:buffer/name other))) (vals (:buffers state))))
      (throw (ex-info "Buffer name is already in use" {:name name})))
    (let [added (assoc state
                       :buffers (assoc (:buffers state) id buffer)
                       :recent (conj (:recent state) id))]
      (if view (assoc added :owners (assoc (:owners state) view id)) added))))

(defn web?
  "Returns true when an id names a live web buffer in a registry state."
  [state id]
  (= :web (:buffer/kind (get (:buffers state) id))))

(defn web-windows
  "Returns the windows of a layout that show a web buffer of a registry state."
  [state layout]
  (window/web-windows layout (fn [id] (web? state id))))

(defn touch
  "Marks a live buffer as selected and moves it to the front of the recency order."
  [state id]
  (assoc state
         :selected id
         :recent (vec (cons id (remove (fn [other] (= id other)) (:recent state))))))

(defn display-window
  "Returns the window that takes a newly selected buffer. A web buffer goes to the window
  that already shows a page, so one page stays visible. Any other buffer, and a web buffer
  without a visible page, goes to the selected window."
  [state id]
  (let [layout (:layout state) pages (web-windows state layout)]
    (if (and (web? state id) (seq pages))
      (:window/id (first pages))
      (:selected layout))))

(defn show
  "Shows a buffer in a window and selects that window. An unchanged layout keeps its revision."
  [layout target id]
  (let [shown (if (= id (:window/buffer (window/window! layout target)))
                layout
                (window/set-buffer layout target id))]
    (if (= target (:selected shown)) shown (window/select shown target))))

(defn select
  "Selects a live buffer and moves it to the front of the recency order. The buffer takes
  its display window. Without a layout, a supplied window id creates the first window."
  ([state id] (select state id nil))
  ([state id window-id]
   (when-not (contains? (:buffers state) id) (stale! id))
   (let [layout (:layout state)]
     (assoc (touch state id)
            :layout (cond
                      layout (show layout (display-window state id) id)
                      window-id (window/initial window-id id)
                      :else nil)))))

(defn replacement
  "Returns the most recent buffer that a window can show without a second visible page, or nil."
  [state layout window-id]
  (first (filter (fn [candidate]
                   (<= (count (web-windows state (window/set-buffer layout window-id candidate))) 1))
                 (:recent state))))

(defn release-windows
  "Returns the layout after a buffer's removal from a registry state. Each window that
  showed the buffer takes its replacement. A window without one is deleted. Deleting the
  only window leaves no layout."
  [state id]
  (loop [layout (:layout state)]
    (let [leaf (when layout
                 (first (filter (fn [leaf] (= id (:window/buffer leaf))) (window/windows layout))))
          heir (when leaf (replacement state layout (:window/id leaf)))]
      (cond
        (nil? leaf) layout
        heir (recur (window/set-buffer layout (:window/id leaf) heir))
        (window/leaf? (:root layout)) nil
        :else (recur (window/delete layout (:window/id leaf)))))))

(defn remove-buffer
  "Removes a live buffer and every reference to it, including its windows. With a layout,
  the selected window's buffer becomes the selection. Without one, a removed selected
  buffer leaves no selection. The buffer's view enters :closing until its close event
  arrives, so late events cannot revive it."
  [state id]
  (when-not (contains? (:buffers state) id) (stale! id))
  (let [view (:buffer/view (get (:buffers state) id))
        removed (assoc state
                       :buffers (dissoc (:buffers state) id)
                       :recent (vec (remove (fn [other] (= id other)) (:recent state)))
                       :selected (when-not (= id (:selected state)) (:selected state)))
        layout (release-windows removed id)
        shown (when layout (:window/buffer (window/window layout (:selected layout))))
        settled (assoc (if (and shown (not= shown (:selected removed))) (touch removed shown) removed)
                       :layout layout)]
    (if view
      (assoc settled
             :owners (dissoc (:owners state) view)
             :pages (dissoc (:pages state) view)
             :closing (conj (:closing state) view))
      settled)))

(defn change-layout
  "Applies a pure bulwark.window operation and arguments to the layout. The result must
  show live buffers and at most one page. The selected window's buffer becomes the selection."
  [state operation & args]
  (when-not (:layout state)
    (throw (ex-info "No window exists" {:error :no-window})))
  (let [layout (apply operation (:layout state) args)
        shown (:window/buffer (window/window! layout (:selected layout)))]
    (doseq [leaf (window/windows layout)]
      (when-not (contains? (:buffers state) (:window/buffer leaf)) (stale! (:window/buffer leaf))))
    (window/check-web-limit layout (fn [id] (web? state id)))
    (assoc (if (= shown (:selected state)) state (touch state shown)) :layout layout)))

(defn label
  "Returns a buffer's explicit name, else its page title, else its URL, else a numbered label."
  [state id]
  (let [record (get (:buffers state) id) page (get (:pages state) (:buffer/view record))]
    (or (:buffer/name record)
        (when (seq (:title page)) (:title page))
        (:url page)
        (str "buffer " id))))

(defn default-modeline
  "Formats a modeline from {:buffer :page :name :selected}: the name, then a page's URL."
  [context]
  (str " " (:name context) (when (:url (:page context)) (str "  " (:url (:page context))))))

(defn panes
  "Returns each window's pane for bulwark.ui/describe: {:kind :view :text :modeline}.
  @modeline-format, or default-modeline, formats the modeline."
  [state]
  (let [layout (:layout state) format (or @modeline-format default-modeline)]
    (reduce (fn [result leaf]
              (let [id (:window/buffer leaf)
                    record (get (:buffers state) id)
                    context {:buffer record
                             :page (get (:pages state) (:buffer/view record))
                             :name (label state id)
                             :selected (= (:window/id leaf) (:selected layout))}]
                (assoc result (:window/id leaf)
                       {:kind (:buffer/kind record) :view (:buffer/view record)
                        :text (:buffer/text record) :modeline (format context)})))
            {}
            (if layout (window/windows layout) []))))

(defn page-event
  "Applies an engine page event to its own view's page state. Events never create or change a buffer.
  A close event forgets the view. Events for a closing view are discarded."
  [state event]
  (let [view (:webview event)
        type (:event/type event)
        page (get (:pages state) view {})
        put (fn [updated] (assoc state :pages (assoc (:pages state) view updated)))]
    (cond
      (not (id? view)) state
      (= type :page/closed) (assoc state
                                   :pages (dissoc (:pages state) view)
                                   :closing (disj (:closing state) view))
      (contains? (:closing state) view) state
      (= type :page/url-changed) (put (assoc page :url (:url event)))
      (= type :page/title-changed) (put (assoc page :title (:title event)))
      (= type :page/load-status-changed) (put (assoc page :load-status (:load-status event)))
      (= type :page/history-changed) (put (assoc page
                                                 :can-go-back (:can-go-back event)
                                                 :can-go-forward (:can-go-forward event)))
      :else state)))

(defn change
  "Applies a function and arguments to one live buffer record."
  [state id f & args]
  (when-not (contains? (:buffers state) id) (stale! id))
  (assoc state :buffers (assoc (:buffers state) id (apply f (get (:buffers state) id) args))))

(defn set-local
  "Sets a buffer-local variable."
  [state id key value]
  (change state id (fn [buffer] (assoc buffer :buffer/locals (assoc (:buffer/locals buffer) key value)))))

(defn set-major-mode
  "Replaces the buffer's major mode keyword."
  [state id mode]
  (when-not (keyword? mode) (throw (ex-info "Major mode must be a keyword" {:mode mode})))
  (change state id assoc :buffer/major-mode mode))

(defn enable-minor-mode
  "Enables a minor mode. The most recently enabled mode comes first; an enabled mode keeps its place."
  [state id mode]
  (when-not (keyword? mode) (throw (ex-info "Minor mode must be a keyword" {:mode mode})))
  (change state id
          (fn [buffer]
            (let [modes (:buffer/minor-modes buffer)]
              (if (some (fn [enabled] (= mode enabled)) modes)
                buffer
                (assoc buffer :buffer/minor-modes (vec (cons mode modes))))))))

(defn disable-minor-mode
  "Disables a minor mode and keeps the order of the others."
  [state id mode]
  (change state id
          (fn [buffer]
            (assoc buffer :buffer/minor-modes
                   (vec (remove (fn [enabled] (= mode enabled)) (:buffer/minor-modes buffer)))))))

(defn set-text
  "Replaces the text of a :text or :repl buffer."
  [state id text]
  (when-not (string? text) (throw (ex-info "Buffer text must be a string" {:buffer id})))
  (change state id
          (fn [buffer]
            (when (= :web (:buffer/kind buffer))
              (throw (ex-info "A web buffer has no text" {:buffer id})))
            (assoc buffer :buffer/text text))))

(defn mode-order
  "Returns a buffer record's modes in precedence order: minor modes, most recently
  enabled first, then the major mode."
  [record]
  (conj (:buffer/minor-modes record) (:buffer/major-mode record)))

(defn keymap-context
  "Returns the ids of the selected buffer's mode keymaps, highest precedence first."
  [state]
  (if-let [record (get (:buffers state) (:selected state))] (mode-order record) []))

;; Accessors read the current registry.

(defn buffer
  "Returns the live buffer record for an id, or nil."
  [id]
  (get (:buffers @registry) id))

(defn buffer!
  "Returns the live buffer record for an id, or raises :stale-buffer."
  [id]
  (or (buffer id) (stale! id)))

(defn buffers
  "Returns live buffer records in creation order."
  []
  (let [live (:buffers @registry)]
    (mapv (fn [id] (get live id)) (sort (keys live)))))

(defn selected-id
  "Returns the selected buffer id, or nil."
  []
  (:selected @registry))

(defn selected
  "Returns the selected buffer record, or nil."
  []
  (buffer (selected-id)))

(defn selected-view
  "Returns the selected web buffer's webview handle, or nil."
  []
  (:buffer/view (selected)))

(defn owner
  "Returns the id of the buffer that owns a webview handle, or nil."
  [view]
  (get (:owners @registry) view))

(defn view-page
  "Returns the page state recorded for a webview handle, or nil."
  [view]
  (get (:pages @registry) view))

(defn page
  "Returns a web buffer's page state: :url, :title, :load-status, :can-go-back, :can-go-forward."
  [id]
  (view-page (:buffer/view (buffer! id))))

(defn find-named
  "Returns the live buffer with an explicit name, or nil."
  [name]
  (first (filter (fn [candidate] (= name (:buffer/name candidate))) (buffers))))

(defn display-name
  "Returns a buffer's explicit name, else its page title, else its URL, else a numbered label."
  [id]
  (buffer! id)
  (label @registry id))

(defn layout
  "Returns the window layout, or nil while no buffer is selected."
  []
  (:layout @registry))

(defn selected-window
  "Returns the selected window's id, or nil."
  []
  (:selected (layout)))

(defn local
  "Returns a buffer-local variable. A value set in the buffer comes first, then the
  defaults of its modes in precedence order, then the supplied default."
  ([id key] (local id key nil))
  ([id key default]
   (let [record (buffer! id)
         scopes (cons (:buffer/locals record)
                      (map (fn [mode] (get @mode-locals mode {})) (mode-order record)))
         scope (first (filter (fn [scope] (contains? scope key)) scopes))]
     (if scope (get scope key) default))))

(defn sync-keymaps!
  "Activates a registry state's keymap context unless it is already active. Callers
  publish a candidate state here before they commit it, so a failed publication leaves
  the registry, the effective keymap, and the native reservations unchanged."
  [state]
  (let [context (keymap-context state)]
    (when-not (= context (:modes @keymap/active))
      (keymap/activate! context)))
  nil)

(defn sync-keymaps-after-removal!
  "Follows a removal, which cannot be refused. A failed publication keeps the previous
  effective keymap and its native reservations, and the error stays in keymap-failure."
  []
  (try
    (sync-keymaps! @registry)
    (reset! keymap-failure nil)
    (catch Exception error
      (reset! keymap-failure error)))
  nil)

(defn alter!
  "Applies a pure transition with a buffer id and arguments to the registry. A change of
  the selected buffer's modes publishes its keymaps first."
  [transition id & args]
  (let [change (fn [state] (apply transition state id args))]
    (sync-keymaps! (change @registry))
    (swap! registry change))
  nil)

(defn set-local! "Sets a buffer-local variable." [id key value] (alter! set-local id key value))
;; These three change the registry and the active keymaps only. bulwark.mode adds
;; definitions and lifecycle hooks.
(defn set-major-mode! "Replaces a buffer's major mode." [id mode] (alter! set-major-mode id mode))
(defn enable-minor-mode! "Enables a minor mode in a buffer." [id mode] (alter! enable-minor-mode id mode))
(defn disable-minor-mode! "Disables a minor mode in a buffer." [id mode] (alter! disable-minor-mode id mode))
(defn set-text!
  "Replaces a non-web buffer's text. Await refresh! to show the change in its windows."
  [id text]
  (alter! set-text id text))

;; Lifecycle operations use host-supplied native mechanisms.

(defn set-host!
  "Installs native mechanisms: :create [url] and :close [view] return awaitable replies,
  and :next-id returns a fresh identifier. Nil keeps the namespace portable.
  bulwark.ui publishes the windows, so the visible page follows the layout."
  [operations]
  (when-not (or (nil? operations)
                (and (map? operations) (every? ifn? (vals operations))))
    (throw (ex-info "Buffer host must be nil or a map of callable mechanisms" {})))
  (reset! host operations)
  nil)

(defn host-operation
  "Returns a required host mechanism, or reports that this runtime has no engine."
  [operation]
  (or (get @host operation)
      (throw (ex-info "This runtime has no native buffer host" {:operation operation}))))

(defn next-id!
  "Returns a fresh buffer id from the host, or from a local counter in a portable runtime."
  []
  (if-let [allocate (:next-id @host)] (allocate) (swap! portable-ids inc)))

(defn value!
  "Returns a successful native value, or raises an error containing the reply."
  [reply]
  (when-not (:ok reply) (throw (ex-info "Native buffer operation failed" reply)))
  (:value reply))

(defn ^:async present!
  "Publishes the UI for a registry state."
  [state]
  (await (ui/present! (:layout state) (panes state))))

(defn ^:async refresh!
  "Makes the native frame match the registry: its windows, the visible page, the focus,
  texts, and modelines. An unchanged frame sends nothing."
  []
  (await (present! @registry)))

(defn ^:async refresh-after-event!
  "Refreshes inside event dispatch. A failed publication must not stop the dispatcher,
  so the error stays in refresh-failure and the next refresh publishes again."
  []
  (try
    (await (refresh!))
    (reset! refresh-failure nil)
    (catch Exception error
      (reset! refresh-failure error)))
  nil)

(defn ^:async commit-selection!
  "Publishes the selection and its keymaps, then commits it. A failure leaves the
  registry unchanged."
  [id]
  (buffer! id)
  (let [window-id (next-id!)]
    (await (present! (select @registry id window-id)))
    (when-not (buffer id)
      ;; The buffer was killed while the native request was parked.
      (await (refresh!))
      (stale! id))
    (let [failure (try
                    (sync-keymaps! (select @registry id window-id))
                    (swap! registry select id window-id)
                    nil
                    (catch Exception error error))]
      ;; After a refused keymap publication, the frame returns to the retained selection.
      (await (refresh!))
      (when failure (throw failure)))
    (keymap/reset-prefix!)
    nil))

(defn ^:async select!
  "Selects a buffer, shows it in its display window, and runs :buffer/selected hooks.
  The hook event contains :buffer and :previous, which can name a killed buffer."
  [id]
  (let [previous (selected-id)]
    (await (commit-selection! id))
    (when-not (= previous id)
      (await (hooks/run-hooks! {:event/type :buffer/selected :buffer id :previous previous})))
    id))

(defn ^:async create!
  "Creates a buffer and returns its id. Options: :kind (default :web), :url for web buffers,
  :select (default true), :name, :major-mode, :locals, and :text.
  The buffer is published only after native creation succeeds. A failed publication closes
  the new webview. Runs :buffer/created hooks, then :buffer/selected hooks."
  [options]
  (let [kind (get options :kind :web)
        view (when (= kind :web) (value! (await ((host-operation :create) (:url options)))))
        outcome (try
                  (let [id (next-id!)]
                    (swap! registry add (make-buffer id kind (assoc options :view view)))
                    {:id id})
                  (catch Exception error {:error error}))]
    (when (:error outcome)
      (when view (await ((host-operation :close) view)))
      (throw (:error outcome)))
    (let [id (:id outcome)
          previous (selected-id)
          selecting (get options :select true)]
      ;; An engine without a description shows its first view. The registry decides instead.
      (if selecting (await (commit-selection! id)) (await (refresh!)))
      (await (hooks/run-hooks! {:event/type :buffer/created :buffer id}))
      (when (and selecting (not= previous id))
        (await (hooks/run-hooks! {:event/type :buffer/selected :buffer id :previous previous})))
      id)))

(defn ^:async settle-removal!
  "Publishes the windows after a removal, runs :buffer/killed hooks, then :buffer/selected
  hooks when a removed selected buffer has a successor, and applies the last-web-buffer policy."
  [record was-selected]
  (let [id (:buffer/id record)
        successor (when was-selected (selected-id))]
    (sync-keymaps-after-removal!)
    (when was-selected (keymap/reset-prefix!))
    (await (refresh!))
    (await (hooks/run-hooks! {:event/type :buffer/killed :buffer id :buffer/record record}))
    (when successor
      (await (hooks/run-hooks! {:event/type :buffer/selected :buffer successor :previous id})))
    (when (and (= :web (:buffer/kind record))
               (not (some (fn [other] (= :web (:buffer/kind other))) (buffers))))
      (when-let [policy @last-web-buffer-policy]
        (await (policy record))))
    nil))

(defn ^:async kill!
  "Kills a buffer. The registry forgets it first, so its id is stale at once and its webview
  closes exactly once. A webview that the engine already closed is not an error.
  Each window that showed the buffer takes the most recent buffer that keeps one page
  visible, or is deleted."
  [id]
  (let [record (buffer! id)
        was-selected (= id (selected-id))
        view (:buffer/view record)]
    (swap! registry remove-buffer id)
    (let [reply (when view (await ((host-operation :close) view)))]
      (await (settle-removal! record was-selected))
      (when (and reply (not (:ok reply)) (not= :stale-handle (:error reply)))
        (throw (ex-info "Native webview close failed" (assoc reply :buffer id))))
      id)))

(defn ^:async handle-event!
  "Routes an engine event to its view's page state and returns the owning buffer id, or nil.
  An engine-initiated close kills the owning buffer without a second native close."
  [event]
  (let [id (owner (:webview event))]
    (if (and id (= :page/closed (:event/type event)))
      (let [record (buffer id) was-selected (= id (selected-id))]
        (swap! registry (fn [state] (page-event (remove-buffer state id) event)))
        (await (settle-removal! record was-selected)))
      (let [before (:pages @registry)]
        (swap! registry page-event event)
        ;; Modelines show page titles and URLs.
        (when-not (= before (:pages @registry))
          (await (refresh-after-event!)))))
    id))

(defn ^:async change-layout!
  "Applies a pure bulwark.window operation and arguments to the layout, publishes the
  result, and commits it. Raises before any change when the result needs a second visible
  page or does not fit the frame. Runs :buffer/selected hooks when the selection moves."
  [operation & args]
  (let [previous (selected-id)
        change (fn [state] (apply change-layout state operation args))
        candidate (change @registry)]
    (ui/check-fit! (:layout candidate))
    (await (present! candidate))
    (let [failure (try
                    (sync-keymaps! (change @registry))
                    (swap! registry change)
                    nil
                    (catch Exception error error))]
      ;; A registry that changed while the request was parked keeps its own layout.
      (await (refresh!))
      (when failure (throw failure)))
    (let [selected (selected-id)]
      (when-not (= previous selected)
        (keymap/reset-prefix!)
        (await (hooks/run-hooks! {:event/type :buffer/selected :buffer selected :previous previous}))))
    nil))
